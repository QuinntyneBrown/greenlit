{
  "ConnectionStrings": {
    "Greenlit": "Server=(localdb)\\MSSQLLocalDB;Database=Greenlit;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Greenlit": {
    "App": {
      "Origin": "REPLACE_VIA_GREENLIT__APP__ORIGIN_ENV",
