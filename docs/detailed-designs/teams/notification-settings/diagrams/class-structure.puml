@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Send email notifications

class Team <<exists>> {
  +Guid Id
  +string Name
  +Guid ManagerUserId
  +string TimeZone
  +DateTimeOffset CreatedUtc
  .. new ..
  +string? HolidayCountry
  +WorkingDays WorkingDays
  +int DefaultYearlyDays
  +int LeaveYearStartMonth
  +int MaxCarryOver
  +int CoverageMinimum
  +bool NotifyNewRequests
  +bool NotifyDecisions
}
class TeamMember <<exists>> {
  +Guid Id
  +Guid TeamId
  +string Name
  +string? Email
  +Guid? UserId
  +int SortOrder
  .. new ..
  +MemberRole Role
  +int? YearlyDays
  +WorkingDays? WorkingDays
  +DateTimeOffset? RemovedUtc
}
class Holiday <<exists>> {
  +Guid Id
  +Guid TeamId
  +DateOnly Date
  +string Name
}
enum WorkingDays <<new, flags>> {
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat
  Sun
}
enum MemberRole <<new>> {
  Member
  Manager
}
Team "1" *-- "*" TeamMember : members
Team "1" *-- "*" Holiday : holidays
Team --> WorkingDays
TeamMember --> MemberRole
TeamMember --> WorkingDays : overrides

class RequestNotifier <<new>> {
  +RequestSent(request: TimeOffRequest): Task
  +RequestDecided(request: TimeOffRequest): Task
}
interface IEmailSender <<new>> {
  +SendAsync(message: EmailMessage): Task
}
class EmailMessage <<new>> {
  +string To
  +string Template
  +Dictionary<string,string> Values
}
RequestNotifier ..> Team : reads switches
RequestNotifier ..> IEmailSender
IEmailSender ..> EmailMessage
@enduml
