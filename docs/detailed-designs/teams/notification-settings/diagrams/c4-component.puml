@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Send email notifications

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
Person(member, "Member", "A row on the sheet; colours and requests their own days")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(section, "NotificationsSection", "Angular component", "Two switches")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "SettingsController", "ASP.NET Core controller", "PUT notifications")
  Component(notifier, "RequestNotifier", "Application service", "Decides who is emailed")
  Component(mail, "IEmailSender", "Application abstraction", "Sends email")
  ComponentDb(db, "Greenlit database", "SQL Server", "Team switches")
}
System_Ext(email, "Email provider", "Delivers invitation, reset and notification emails")

Rel(manager, section, "Switches")
Rel(section, ctrl, "PUT /api/team/settings/notifications", "JSON/HTTPS")
Rel(ctrl, db, "Saves switches", "EF Core")
Rel(notifier, db, "Reads switches", "EF Core")
Rel(notifier, mail, "Sends")
Rel(mail, email, "Delivers", "SMTP <TO SUPPLY>")
@enduml
