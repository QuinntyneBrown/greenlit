@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Create a team

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
System(greenlit, "Greenlit", "Shared team time-off sheet that replaces the vacation spreadsheet")
System_Ext(email, "Email provider", "Delivers invitation, reset and notification emails")
System_Ext(holidays, "Public-holiday source", "Publishes each country's public holidays <TO SUPPLY>")

Rel(manager, greenlit, "Sets up a team in")
Rel(greenlit, email, "Sends email via", "SMTP <TO SUPPLY>")
Rel(greenlit, holidays, "Reads public holidays from", "<TO SUPPLY>")
@enduml
