@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Create a team

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(page, "CreateTeamPage", "Angular page", "Team form")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "TeamsController", "ASP.NET Core controller", "POST /api/teams")
  Component(handler, "CreateTeamCommandHandler", "MediatR handler", "Creates team, rows, holidays, invitations")
  Component(hol, "IPublicHolidayProvider", "Application abstraction", "Country holidays")
  Component(mail, "IEmailSender", "Application abstraction", "Sends invitations")
  ComponentDb(db, "Greenlit database", "SQL Server", "Teams, members, holidays")
}
System_Ext(email, "Email provider", "Delivers invitation, reset and notification emails")
System_Ext(holidays, "Public-holiday source", "Publishes each country's public holidays <TO SUPPLY>")

Rel(manager, page, "Fills in")
Rel(page, ctrl, "POST /api/teams", "JSON/HTTPS")
Rel(ctrl, handler, "Sends CreateTeamCommand")
Rel(handler, hol, "Reads holidays")
Rel(handler, db, "Writes in one unit of work", "EF Core")
Rel(handler, mail, "Sends invitations")
Rel(hol, holidays, "Reads", "<TO SUPPLY>")
Rel(mail, email, "Delivers", "SMTP <TO SUPPLY>")
@enduml
