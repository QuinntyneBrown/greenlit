@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Invite a member

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(dialog, "InviteMemberDialog", "CDK Dialog", "Name, email, role")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "MembersController", "ASP.NET Core controller", "POST /api/team/members")
  Component(handler, "InviteMemberCommandHandler", "MediatR handler", "Adds row, sends invitation")
  Component(mail, "IEmailSender", "Application abstraction", "Invitation email")
  ComponentDb(db, "Greenlit database", "SQL Server", "Members, invitations")
}
System_Ext(email, "Email provider", "Delivers invitation, reset and notification emails")

Rel(manager, dialog, "Enters name, email, role")
Rel(dialog, ctrl, "POST /api/team/members", "JSON/HTTPS")
Rel(ctrl, handler, "Sends InviteMemberCommand")
Rel(handler, db, "Adds member and invitation", "EF Core")
Rel(handler, mail, "Sends link")
Rel(mail, email, "Delivers", "SMTP <TO SUPPLY>")
@enduml
