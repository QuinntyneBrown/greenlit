@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Run several teams

Person(manager, "Manager", "Runs several teams")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(section, "YourTeamsSection", "Angular component", "Settings section#teams")
  Component(switcher, "TeamSwitcher", "gl-team-switcher", "Header menu of teams")
  Component(state, "ManagedTeamsState", "Angular service", "Teams, switch, default, toasts, remount")
  Component(client, "HttpTeamService", "TEAM_SERVICE", "mine, switchTo, makeDefault")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "TeamsController", "ASP.NET Core controller", "/api/teams")
  Component(mine, "GetMyTeamsQueryHandler", "MediatR handler", "Teams the caller manages")
  Component(sw, "SwitchTeamCommandHandler", "MediatR handler", "New session for a managed team")
  Component(def, "SetDefaultTeamCommandHandler", "MediatR handler", "User.DefaultTeamId")
  Component(signin, "SignInCommandHandler", "MediatR handler", "Session for TeamChoice")
  Component(active, "ActiveTeam / TeamChoice", "Application helpers", "Active team from the session; sign-in team")
  ComponentDb(db, "Greenlit database", "SQL Server", "Users, Teams, TeamMembers")
}

Rel(manager, section, "Switch to this team, Make default")
Rel(manager, switcher, "Chooses a team")
Rel(section, state, "Uses")
Rel(switcher, state, "Uses")
Rel(state, client, "Calls")
Rel(client, ctrl, "JSON/HTTPS")
Rel(ctrl, mine, "Sends")
Rel(ctrl, sw, "Sends")
Rel(ctrl, def, "Sends")
Rel(signin, active, "Uses")
Rel(mine, active, "Uses")
Rel(mine, db, "Reads", "EF Core")
Rel(sw, db, "Reads", "EF Core")
Rel(def, db, "Writes", "EF Core")
@enduml
