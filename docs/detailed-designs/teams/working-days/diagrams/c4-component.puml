@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Set working days

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(section, "WorkWeekSection", "Angular component", "Team work week")
  Component(dialog, "EditWorkingDaysDialog", "CDK Dialog", "Member working days")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(settings, "SettingsController", "ASP.NET Core controller", "PUT work-week")
  Component(members, "MembersController", "ASP.NET Core controller", "PUT working-days")
  Component(handler, "SetMemberWorkingDaysCommandHandler", "MediatR handler", "Saves the override")
  Component(rule, "WeekendRule", "Domain service", "Decides non-working days")
  ComponentDb(db, "Greenlit database", "SQL Server", "Teams, members")
}

Rel(manager, section, "Sets work week")
Rel(manager, dialog, "Sets member days")
Rel(section, settings, "PUT /api/team/settings/work-week", "JSON/HTTPS")
Rel(dialog, members, "PUT /api/team/members/{id}/working-days", "JSON/HTTPS")
Rel(members, handler, "Sends command")
Rel(handler, db, "Saves", "EF Core")
Rel(rule, db, "Reads team and member days", "EF Core")
@enduml
