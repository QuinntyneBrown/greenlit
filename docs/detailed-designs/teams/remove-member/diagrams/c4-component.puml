@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Remove a member

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(dialog, "RemoveMemberDialog", "CDK Dialog", "Confirms removal")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "MembersController", "ASP.NET Core controller", "DELETE /api/team/members/{id}")
  Component(handler, "RemoveMemberCommandHandler", "MediatR handler", "Stamps RemovedUtc")
  ComponentDb(db, "Greenlit database", "SQL Server", "Members")
}

Rel(manager, dialog, "Confirms")
Rel(dialog, ctrl, "DELETE /api/team/members/{id}", "JSON/HTTPS")
Rel(ctrl, handler, "Sends RemoveMemberCommand")
Rel(handler, db, "Updates RemovedUtc", "EF Core")
@enduml
