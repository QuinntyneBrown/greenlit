@startuml
title UML sequence behaviour — Remove a member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Manager" as actor
box "Frontend — Greenlit web application (Angular)" #E0F2FE
  participant "RemoveMemberDialog" as dialog
  participant "HttpTeamService" as client
end box
box "Backend — Greenlit.Api application" #D1FADF
  participant "MembersController" as ctrl
end box
box "Backend — Greenlit.Application and Greenlit.Domain" #ECFDF3
  participant "RemoveMemberCommandHandler" as handler
end box
box "Backend — Greenlit.Infrastructure" #FFF4E5
  database "Greenlit database" as db
end box
actor -> dialog : "Remove Ben", then "Yes, remove Ben" (L2-011 AC1)
dialog -> dialog : Show "Removing…"
dialog -> client : remove(memberId)
client -> ctrl : DELETE /api/team/members/{id}
ctrl -> handler : Send RemoveMemberCommand (Manager policy)
handler -> db : Set RemovedUtc, keep TimeOffDay rows
alt removed
  ctrl --> client : 204
  dialog --> actor : Calendar without Ben (L2-011 AC2)
else failed
  ctrl --> client : 500 ProblemDetails
  dialog --> actor : "We couldn’t remove Ben", nothing changed (L2-011 AC3)
end
@enduml
