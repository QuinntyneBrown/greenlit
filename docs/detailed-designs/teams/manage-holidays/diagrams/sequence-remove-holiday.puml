@startuml
title UML sequence behaviour — Remove a holiday and undo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Manager" as actor
box "Frontend — Greenlit web application (Angular)" #E0F2FE
  participant "RemoveHolidayDialog" as dialog
  participant "ToastService" as toast
  participant "HttpHolidayService" as client
end box
box "Backend — Greenlit.Api application" #D1FADF
  participant "HolidaysController" as ctrl
end box
box "Backend — Greenlit.Application and Greenlit.Domain" #ECFDF3
  participant "RemoveHolidayCommandHandler" as handler
end box
box "Backend — Greenlit.Infrastructure" #FFF4E5
  database "Greenlit database" as db
end box
actor -> dialog : "Remove Spring bank holiday", then "Remove holiday" (L2-038 AC1)
dialog -> client : remove(id)
client -> ctrl : DELETE /api/team/holidays/{id}
ctrl -> handler : Send RemoveHolidayCommand
handler -> db : Set RemovedUtc
ctrl --> client : 204
dialog -> toast : "Removed Spring bank holiday" with Undo (L2-038 AC2)
opt Undo
  actor -> toast : Undo
  toast -> client : restore(id)
  client -> ctrl : POST /api/team/holidays/{id}/restore
  ctrl --> client : 204, holiday back (L2-038 AC3)
end
@enduml
