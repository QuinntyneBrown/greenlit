@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Adjust a member's allowance

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(dialog, "AdjustAllowanceDialog", "CDK Dialog", "Days and reason")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "PeopleController", "ASP.NET Core controller", "POST adjustments")
  Component(handler, "AddAdjustmentCommandHandler", "MediatR handler", "Stores the adjustment")
  ComponentDb(db, "Greenlit database", "SQL Server", "Adjustments")
}

Rel(manager, dialog, "Enters days and reason")
Rel(dialog, ctrl, "POST /api/people/{id}/adjustments", "JSON/HTTPS")
Rel(ctrl, handler, "Sends command")
Rel(handler, db, "Inserts", "EF Core")
@enduml
