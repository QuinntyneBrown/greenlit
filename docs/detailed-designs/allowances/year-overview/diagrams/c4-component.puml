@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View the team's year

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
Person(member, "Member", "A row on the sheet; colours and requests their own days")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(page, "YearPage", "Angular page", "Grid and table")
  Component(grid, "YearGrid", "gl-year-grid", "Months per member")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "YearController", "ASP.NET Core controller", "GET /api/year")
  Component(handler, "GetYearQueryHandler", "MediatR handler", "Months and allowances")
  Component(calc, "AllowanceCalculator", "Domain service", "Allowance figures")
  ComponentDb(db, "Greenlit database", "SQL Server", "Days")
}

Rel(manager, page, "Views")
Rel(member, page, "Views")
Rel(page, grid, "Renders")
Rel(page, ctrl, "GET /api/year?year=", "JSON/HTTPS")
Rel(ctrl, handler, "Sends GetYearQuery")
Rel(handler, db, "Confirmed days by month", "EF Core")
Rel(handler, calc, "Allowance per member")
@enduml
