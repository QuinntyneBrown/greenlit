@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Compute allowances

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
Person(member, "Member", "A row on the sheet; colours and requests their own days")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(section, "AllowancesSection", "Angular component", "Defaults")
  Component(banner, "MissingAllowanceBanner", "Angular component", "Members on the default")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "SettingsController", "ASP.NET Core controller", "PUT allowances")
  Component(save, "SaveAllowanceDefaultsCommandHandler", "MediatR handler", "Saves defaults")
  Component(calc, "AllowanceCalculator", "Domain service", "Every allowance figure")
  Component(rule, "WeekendRule", "Domain service", "Working days only")
  ComponentDb(db, "Greenlit database", "SQL Server", "Teams, members, adjustments, days")
}

Rel(manager, section, "Sets defaults")
Rel(section, ctrl, "PUT /api/team/settings/allowances", "JSON/HTTPS")
Rel(ctrl, save, "Sends command")
Rel(save, db, "Saves", "EF Core")
Rel(calc, rule, "Counts working days")
Rel(calc, db, "Reads days and adjustments", "EF Core")
Rel(member, section, "Reads (read-only)")
@enduml
