@startuml
title UML sequence behaviour — Compute a member's allowance
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Greenlit web application (Angular)" #E0F2FE
  participant "Calendar, year or person page" as page
end box
box "Backend — Greenlit.Api application" #D1FADF
  participant "Query endpoint" as ctrl
end box
box "Backend — Greenlit.Application and Greenlit.Domain" #ECFDF3
  participant "Query handler" as handler
  participant "AllowanceCalculator" as calc
  participant "WeekendRule" as rule
end box
box "Backend — Greenlit.Infrastructure" #FFF4E5
  database "Greenlit database" as db
end box
actor -> page : Open a page that shows days left
page -> ctrl : GET (sheet, year or person)
ctrl -> handler : Send query
handler -> db : Team defaults, member, adjustments, days in leave year
handler -> calc : For(member, leaveYear, today)
calc -> calc : Allowance = yearly days (or default) + adjustments (L2-029 AC1)
calc -> rule : Keep working days only (L2-029 AC5)
calc -> calc : Used before today, Booked from today (L2-029 AC2)
calc -> calc : Requested, Tentative (L2-029 AC3)
calc -> calc : Left = Allowance - Used - Booked (L2-029 AC4)
calc -> calc : Over when Left - Requested < 0 (L2-030 AC1)
calc --> handler : Allowance
handler --> ctrl : DTO with figures
ctrl --> page : 200
page --> actor : Days left, over-allowance text where it applies
@enduml
