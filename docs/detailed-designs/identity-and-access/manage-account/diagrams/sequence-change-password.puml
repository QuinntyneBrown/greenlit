@startuml
title UML sequence behaviour — Change the password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Team user" as actor
box "Frontend — Greenlit web application (Angular)" #E0F2FE
  participant "AccountPage" as page
  participant "HttpAccountService" as client
end box
box "Backend — Greenlit.Api application" #D1FADF
  participant "AccountController" as ctrl
end box
box "Backend — Greenlit.Application and Greenlit.Domain" #ECFDF3
  participant "ChangePasswordCommandHandler" as handler
  participant "IPasswordHasher" as hasher
end box
box "Backend — Greenlit.Infrastructure" #FFF4E5
  database "Greenlit database" as db
end box
actor -> page : Current, new and confirm password, "Update password"
page -> page : Check 10 characters and match (L2-005 AC2)
page -> client : changePassword(current, next)
client -> ctrl : PUT /api/account/password
ctrl -> handler : Send ChangePasswordCommand for ICurrentUser.UserId
handler -> db : Load User
handler -> hasher : Verify(current)
alt current password correct
  handler -> hasher : Hash(next)
  handler -> db : Save PasswordHash
  ctrl --> client : 204
  page --> actor : "Password updated" (L2-005 AC3)
else wrong current password
  ctrl --> client : 400 ProblemDetails, code current_password_wrong
  page --> actor : Error on Current password
end
@enduml
