@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Use the account menu and sign out

Person(person, "Team user", "A manager or member of a team")
System_Boundary(greenlit, "Greenlit") {
  Container(spa, "Greenlit web application", "Angular", "Pages, dialogs and the gl-* components")
  Container(api, "Greenlit API", "ASP.NET Core (Greenlit.Api)", "Controllers, MediatR handlers, domain rules")
  ContainerDb(db, "Greenlit database", "SQL Server; SQLite in tests", "Teams, members, days, requests")
}

Rel(person, spa, "Opens the account menu in", "HTTPS")
Rel(spa, api, "Ends the session through", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
