@startuml
title UML sequence behaviour — Choose a new password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Greenlit web application (Angular)" #E0F2FE
  participant "ResetPasswordPage" as page
  participant "HttpAuthService" as client
end box
box "Backend — Greenlit.Api application" #D1FADF
  participant "AuthController" as ctrl
end box
box "Backend — Greenlit.Application and Greenlit.Domain" #ECFDF3
  participant "ResetPasswordCommandHandler" as handler
  participant "PasswordResetToken" as token
end box
box "Backend — Greenlit.Infrastructure" #FFF4E5
  database "Greenlit database" as db
end box
actor -> page : Enter new password and confirmation
page -> page : Check 10 characters and match (L2-003 AC2, AC3)
page -> client : resetPassword(token, password)
client -> ctrl : POST /api/auth/password-reset/confirm
ctrl -> handler : Send ResetPasswordCommand
handler -> db : Load token by hash
db --> handler : Token or none
handler -> token : IsUsable(now)
alt usable
  handler -> db : Set User.PasswordHash, stamp UsedUtc
  ctrl --> client : 204
  page --> actor : "Password updated" and "Sign in" (L2-003 AC5)
else expired, used or unknown
  ctrl --> client : 410 ProblemDetails, code reset_link_expired
  page --> actor : "This link has expired" and "Request a new link" (L2-003 AC4)
end
@enduml
