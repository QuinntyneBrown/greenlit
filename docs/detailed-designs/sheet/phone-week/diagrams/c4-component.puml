@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — The calendar on a phone

Person(member, "Member", "A row on the sheet; colours and requests their own days")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(page, "CalendarPage", "Angular page", "Loads the month; picks grid or week by BreakpointObserver; saves, undoes")
  Component(week, "CalendarWeek", "Angular component (app)", "Week, open day and range state; short days; clash")
  Component(view, "week-view", "Pure functions", "Weeks of a month, the week's cells, short runs, clash text")
  Component(tabs, "WeekTabs", "gl-week-tabs", "Tab list labelled Week")
  Component(strip, "WeekStrip", "gl-week-strip", "Dates, member rows, Out line, bands")
  Component(sheet, "MarkSheet", "gl-mark-sheet", "Selected days: pick last day, actions")
  Component(svc, "HttpSheetService", "SHEET_SERVICE implementation", "month(), setDays(), restore()")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "SheetController", "ASP.NET Core controller", "GET /api/sheet, PUT /api/sheet/days")
}

Rel(member, week, "Taps")
Rel(page, week, "SheetMonth, isManager, readOnly")
Rel(week, view, "Derives")
Rel(week, tabs, "Weeks, selected")
Rel(week, strip, "Days, rows, cover, short, open, range")
Rel(week, sheet, "Range, working days, over, clash")
Rel(week, page, "mark(memberId, dates, status), cleared")
Rel(page, svc, "setDays() / restore()")
Rel(svc, ctrl, "PUT /api/sheet/days", "JSON/HTTPS")
@enduml
