@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Approve a request

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(detail, "RequestDetailDialog", "CDK Dialog", "Approve")
  Component(toast, "ToastService", "Angular service", "Outcome and Undo")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "RequestsController", "ASP.NET Core controller", "approve, reopen")
  Component(handler, "ApproveRequestsCommandHandler", "MediatR handler", "Approves")
  Component(cov, "CoverageCalculator", "Domain service", "Below-minimum check")
  Component(notifier, "RequestNotifier", "Application service", "Decision email")
  ComponentDb(db, "Greenlit database", "SQL Server", "Requests, days")
}
System_Ext(email, "Email provider", "Delivers invitation, reset and notification emails")

Rel(manager, detail, "Approves")
Rel(detail, ctrl, "POST /api/requests/approve", "JSON/HTTPS")
Rel(detail, toast, "Reports")
Rel(ctrl, handler, "Sends command")
Rel(handler, db, "Confirms days", "EF Core")
Rel(handler, cov, "Checks coverage")
Rel(handler, notifier, "RequestDecided")
Rel(notifier, email, "Emails member", "SMTP <TO SUPPLY>")
@enduml
