@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Review requests

Person(manager, "Manager", "Confirms requests; owns holidays, settings and membership")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(page, "RequestsPage", "Angular page", "Ledger tabs")
  Component(detail, "RequestDetailDialog", "CDK Dialog", "Request and team view")
  Component(nav, "AppNav", "gl-app-nav", "Pending count")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "RequestsController", "ASP.NET Core controller", "/api/requests")
  Component(list, "ListRequestsQueryHandler", "MediatR handler", "Requests by status")
  Component(get, "GetRequestQueryHandler", "MediatR handler", "Detail and team weeks")
  Component(bulk, "ApproveRequestsCommandHandler", "MediatR handler", "Bulk approve")
  ComponentDb(db, "Greenlit database", "SQL Server", "Requests, days")
}

Rel(manager, page, "Reviews")
Rel(page, detail, "Opens")
Rel(page, ctrl, "GET /api/requests?status=", "JSON/HTTPS")
Rel(detail, ctrl, "GET /api/requests/{id}", "JSON/HTTPS")
Rel(nav, ctrl, "GET pending-count", "JSON/HTTPS")
Rel(ctrl, list, "Sends query")
Rel(ctrl, get, "Sends query")
Rel(ctrl, bulk, "Sends command")
Rel(list, db, "Reads", "EF Core")
Rel(get, db, "Reads", "EF Core")
Rel(bulk, db, "Writes", "EF Core")
@enduml
