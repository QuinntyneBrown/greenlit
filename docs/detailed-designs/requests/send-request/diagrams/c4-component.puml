@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Send a time-off request

Person(member, "Member", "A row on the sheet; colours and requests their own days")
Container_Boundary(spa_b, "Greenlit web application") {
  Component(dialog, "NewRequestDialog", "CDK Dialog", "Dates, note, count")
  Component(svc, "HttpRequestService", "REQUEST_SERVICE implementation", "quote, send")
}
Container_Boundary(api_b, "Greenlit API") {
  Component(ctrl, "RequestsController", "ASP.NET Core controller", "/api/requests")
  Component(quote, "QuoteRequestQueryHandler", "MediatR handler", "Counts days")
  Component(send, "SendRequestCommandHandler", "MediatR handler", "Creates the request")
  Component(alloc, "AllowanceCalculator", "Domain service", "Days left")
  Component(notifier, "RequestNotifier", "Application service", "Emails the manager")
  ComponentDb(db, "Greenlit database", "SQL Server", "Requests, days")
}

Rel(member, dialog, "Picks dates")
Rel(dialog, svc, "quote(), send()")
Rel(svc, ctrl, "GET quote, POST", "JSON/HTTPS")
Rel(ctrl, quote, "Sends query")
Rel(ctrl, send, "Sends SendRequestCommand")
Rel(quote, alloc, "Days left")
Rel(send, db, "Writes request and days", "EF Core")
Rel(send, notifier, "RequestSent")
@enduml
